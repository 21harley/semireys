---
---

<div class="logo-gallery-selector-wrapper">
	<label class="control-label">1. Galería de Emblemas:</label>
	
	<div class="decal-gallery" id="decal-gallery-container">
		<button type="button" class="decal-item-btn" data-decal-url="/decals/logo_semireys.svg">
			<img src="/decals/logo_semireys.svg" alt="Monograma SEMIREYS" />
			<span>Logo SEMIREYS</span>
		</button>
		<button type="button" class="decal-item-btn" data-decal-url="/decals/crown.svg">
			<img src="/decals/crown.svg" alt="Corona Real" />
			<span>Corona</span>
		</button>
		<button type="button" class="decal-item-btn" data-decal-url="/decals/star.svg">
			<img src="/decals/star.svg" alt="Estrella" />
			<span>Estrella</span>
		</button>
	</div>

	<!-- Collapsible details dropdown for custom SVG upload -->
	<details class="custom-svg-details" id="custom-svg-details">
		<summary class="custom-svg-summary">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M12 5v14M5 12h14"/>
			</svg>
			<span>📁 Cargar Tu Propio Logo SVG</span>
		</summary>
		
		<div class="custom-svg-upload-box">
			<input type="file" id="custom-svg-file-input" accept=".svg,image/svg+xml" class="hidden-file-input" />
			<button type="button" class="btn-custom-upload" id="btn-trigger-svg-upload">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
					<polyline points="17 8 12 3 7 8"></polyline>
					<line x1="12" y1="3" x2="12" y2="15"></line>
				</svg>
				<span>Seleccionar Archivo SVG</span>
			</button>
			<p class="upload-hint-text" id="svg-upload-status">Solo archivos vectoriales válidos en formato .svg</p>
		</div>
	</details>
</div>

<style>
	.logo-gallery-selector-wrapper {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.control-label {
		font-weight: 700;
		font-size: 0.9rem;
		color: var(--text-primary);
	}

	/* Decal Gallery */
	.decal-gallery {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
	}

	.decal-item-btn {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		padding: 0.6rem;
		background: #FFFFFF;
		border: 1.5px solid var(--border-color);
		border-radius: var(--radius-sm);
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.decal-item-btn img {
		width: 42px;
		height: 42px;
		object-fit: contain;
	}

	.decal-item-btn span {
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--text-primary);
		word-break: break-all;
	}

	.decal-item-btn:hover, .decal-item-btn.active {
		border-color: var(--accent-primary);
		background-color: var(--accent-soft);
	}

	/* Collapsible details dropdown */
	.custom-svg-details {
		background: #F8FAFC;
		border: 1.5px dashed var(--accent-primary);
		border-radius: var(--radius-md);
		overflow: hidden;
		transition: all 0.2s ease;
		margin-top: 0.25rem;
	}

	.custom-svg-details[open] {
		border-style: solid;
		background: #FFFFFF;
		box-shadow: 0 4px 14px rgba(194, 125, 56, 0.12);
	}

	.custom-svg-summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1rem;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent-primary);
		cursor: pointer;
		user-select: none;
		list-style: none;
		transition: background 0.2s ease;
	}

	.custom-svg-summary::-webkit-details-marker {
		display: none;
	}

	.custom-svg-summary:hover {
		background: var(--accent-soft);
	}

	/* Custom SVG Uploader Styling */
	.custom-svg-upload-box {
		padding: 0.85rem;
		border-top: 1px solid var(--border-color);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		text-align: center;
		background: #F8FAFC;
	}

	.hidden-file-input {
		display: none;
	}

	.btn-custom-upload {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.75rem 1rem;
		background: #FFFFFF;
		border: 1.5px solid var(--accent-primary);
		color: var(--accent-primary);
		border-radius: var(--radius-sm);
		font-family: inherit;
		font-size: 0.84rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.2s ease;
		box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
	}

	.btn-custom-upload:hover {
		background: var(--accent-primary);
		color: #FFFFFF;
		transform: translateY(-1px);
	}

	.upload-hint-text {
		font-size: 0.73rem;
		color: var(--text-muted);
		margin: 0;
		font-weight: 500;
	}
</style>
