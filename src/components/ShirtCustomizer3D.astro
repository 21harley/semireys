---
import FontPreviewSelector from './FontPreviewSelector.astro';
import LogoGallerySelector from './LogoGallerySelector.astro';
import '../styles/shirt-customizer-3d.css';

interface Props {
	initialColor?: string;
	initialColorName?: string;
	initialSize?: string;
	productName?: string;
}

const { initialColor = "#F4F1EA", initialColorName = "Blanco Hueso", initialSize = "", productName = "Camisa de Lino Semireys" } = Astro.props;
---

<div class="customizer-3d-wrapper">
	<!-- Canvas & 3D Viewport Container -->
	<div class="viewport-container" id="viewport-container">
		<canvas id="webgl-canvas"></canvas>

		<!-- Loader Overlay -->
		<div class="loading-overlay" id="loading-overlay">
			<div class="spinner"></div>
			<p id="loading-text">Cargando Modelo 3D de Camisa...</p>
			<div class="progress-bar-bg">
				<div class="progress-bar-fill" id="progress-bar"></div>
			</div>
		</div>

		<!-- Top Left Viewport Hints & Indicators -->
		<div class="viewport-hints">
			<span class="hint-badge" id="hint-badge">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.85.84 6.72 2.25L21 3v6h-6l2.39-2.39A6.97 6.97 0 1 0 19 12h2z" />
				</svg>
				Arrastra · Rota · Pellizca para Zoom
			</span>
			<div class="decal-mode-indicator hidden" id="decal-mode-indicator">
				🎯 Modo Activo: Toca la camisa para fijar
			</div>
		</div>

		<!-- Compact Mode Toolbar (Bottom of Viewport) -->
		<div class="viewport-mode-toolbar">
			<button type="button" class="mode-btn active" id="mode-rotate-btn" title="Girar Camisa (360°)">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0" />
					<path d="M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v6" />
					<path d="M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8" />
					<path d="M18 8a2 2 0 0 1 2 2v4a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
				</svg>
				<span class="mode-btn-label">Girar</span>
			</button>

			<div class="toolbar-divider"></div>

			<button type="button" class="mode-btn" id="mode-decal-btn" title="Estampar Logo / Texto en la camisa">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<circle cx="12" cy="12" r="10" />
					<line x1="12" y1="8" x2="12" y2="16" />
					<line x1="8" y1="12" x2="16" y2="12" />
				</svg>
				<span class="mode-btn-label" id="mode-decal-btn-label">Estampar</span>
			</button>

			<button type="button" class="mode-btn" id="mode-move-btn" title="Mover Logo o Texto">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<polyline points="5 9 2 12 5 15" />
					<polyline points="9 5 12 2 15 5" />
					<polyline points="15 19 12 22 9 19" />
					<polyline points="19 9 22 12 19 15" />
					<line x1="2" y1="12" x2="22" y2="12" />
					<line x1="12" y1="2" x2="12" y2="22" />
				</svg>
				<span class="mode-btn-label" id="mode-move-btn-label">Mover</span>
			</button>

			<button type="button" class="mode-btn danger-mode" id="mode-remove-decals-btn" title="Eliminar Logo o Texto">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<polyline points="3 6 5 6 21 6" />
					<path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
				</svg>
				<span class="mode-btn-label" id="mode-remove-btn-label">Eliminar</span>
			</button>

			<div class="toolbar-divider"></div>

			<button type="button" class="mode-btn share-mode" id="mode-share-toolbar-btn" title="Tomar Fotos Multángulo y Enviar por WhatsApp">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
					<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
					<circle cx="12" cy="13" r="4" />
				</svg>
				<span class="mode-btn-label">Enviar</span>
			</button>
		</div>
	</div>

	<!-- Customization Controls Panel: Header + Scrollable Body + Fixed Footer -->
	<div class="controls-panel">

		<!-- Fixed Header: Product Info + Category Tabs -->
		<div class="panel-header">
			<div class="panel-product-info">
				<h2>Personalizador 3D</h2>
				<div class="panel-badges">
					<span class="product-name-badge" id="product-name-badge">{productName}</span>
					<span class="product-name-badge color-badge" id="color-size-badge" style="display:none;"></span>
				</div>
			</div>
			<!-- Category Tabs (moved from viewport to panel) -->
			<div class="panel-tab-row">
				<button type="button" class="tab-btn active" data-tab="color">🎨 Color</button>
				<button type="button" class="tab-btn" data-tab="decal">🏷️ Logos</button>
				<button type="button" class="tab-btn" data-tab="text">✍️ Texto</button>
			</div>
		</div>

		<!-- Scrollable Body -->
		<div class="panel-body">

			<!-- Tab 1: Color -->
			<div class="tab-content active" id="tab-color">
				<label class="control-label">Selecciona el color del tejido:</label>
				<div class="color-presets-grid">
					<button type="button" class="color-preset-btn color-chip-card active" data-color="#F4F1EA" data-color-name="Blanco Hueso" title="Blanco Hueso">
						<span class="chip-swatch" style="background:#F4F1EA"></span>
						<span class="chip-label">Blanco Hueso</span>
					</button>
					<button type="button" class="color-preset-btn color-chip-card" data-color="#E68B75" data-color-name="Salmón" title="Salmón">
						<span class="chip-swatch" style="background:#E68B75"></span>
						<span class="chip-label">Salmón</span>
					</button>
					<button type="button" class="color-preset-btn color-chip-card" data-color="#1B2A4A" data-color-name="Azul Marino" title="Azul Marino">
						<span class="chip-swatch" style="background:#1B2A4A"></span>
						<span class="chip-label">Azul Marino</span>
					</button>
					<button type="button" class="color-preset-btn color-chip-card" data-color="#121824" data-color-name="Negro Ébano" title="Negro Ébano">
						<span class="chip-swatch" style="background:#121824"></span>
						<span class="chip-label">Negro Ébano</span>
					</button>
					<button type="button" class="color-preset-btn color-chip-card" data-color="#4A5D4E" data-color-name="Verde Oliva" title="Verde Oliva">
						<span class="chip-swatch" style="background:#4A5D4E"></span>
						<span class="chip-label">Verde Oliva</span>
					</button>
					<button type="button" class="color-preset-btn color-chip-card" data-color="#D9C5B2" data-color-name="Arena Lino" title="Arena Lino">
						<span class="chip-swatch" style="background:#D9C5B2"></span>
						<span class="chip-label">Arena Lino</span>
					</button>
					<button type="button" class="color-preset-btn color-chip-card" data-color="#C41E3A" data-color-name="Rojo" title="Rojo">
						<span class="chip-swatch" style="background:#C41E3A"></span>
						<span class="chip-label">Rojo</span>
					</button>
					<button type="button" class="color-preset-btn color-chip-card" data-color="#7B2D8B" data-color-name="Morado" title="Morado">
						<span class="chip-swatch" style="background:#7B2D8B"></span>
						<span class="chip-label">Morado</span>
					</button>
					<button type="button" class="color-preset-btn color-chip-card" data-color="#8B4513" data-color-name="Café" title="Café">
						<span class="chip-swatch" style="background:#8B4513"></span>
						<span class="chip-label">Café</span>
					</button>
					<button type="button" class="color-preset-btn color-chip-card" data-color="#FF8C00" data-color-name="Naranja" title="Naranja">
						<span class="chip-swatch" style="background:#FF8C00"></span>
						<span class="chip-label">Naranja</span>
					</button>
					<button type="button" class="color-preset-btn color-chip-card" data-color="#2E8B57" data-color-name="Verde" title="Verde">
						<span class="chip-swatch" style="background:#2E8B57"></span>
						<span class="chip-label">Verde</span>
					</button>
					<button type="button" class="color-preset-btn color-chip-card" data-color="#C27D38" data-color-name="Cobrizo" title="Cobrizo">
						<span class="chip-swatch" style="background:#C27D38"></span>
						<span class="chip-label">Cobrizo</span>
					</button>
				</div>

				<div class="custom-color-picker-wrapper">
					<label for="shirt-custom-color">🎨 Color Personalizado:</label>
					<input type="color" id="shirt-custom-color" value={initialColor} />
				</div>
			</div>

			<!-- Tab 2: Logos & Emblems -->
			<div class="tab-content" id="tab-decal">
				<LogoGallerySelector />
				<div class="decal-adjustments hidden-animated" id="decal-adjustments">
					<div class="adjustment-header">
						<span class="control-label">2. Ajustar Logo Seleccionado</span>
						<span class="decal-count-badge" id="decal-count-badge">0 logos</span>
					</div>
					<div class="slider-group-column">
						<div class="slider-header">
							<span>Tamaño:</span>
							<span class="value-badge" id="logo-scale-val-badge">15% (~12 cm)</span>
						</div>
						<input type="range" id="decal-scale" min="0.05" max="0.35" step="0.01" value="0.15" class="custom-ui-range" />
					</div>
					<div class="slider-group-column">
						<div class="slider-header">
							<span>Rotación:</span>
							<span class="value-badge" id="logo-rot-val-badge">0°</span>
						</div>
						<input type="range" id="decal-rotation" min="-180" max="180" step="5" value="0" class="custom-ui-range" />
					</div>
					<div class="decal-action-btns">
						<button type="button" class="btn-secondary danger" id="btn-delete-selected">🗑️ Eliminar Logo</button>
						<button type="button" class="btn-secondary outline" id="btn-clear-all">Limpiar Todos</button>
					</div>
				</div>
			</div>

			<!-- Tab 3: Text -->
			<div class="tab-content" id="tab-text">
				<label class="control-label">1. Escribe tu Texto:</label>
				<input type="text" id="custom-text-input" value="SEMIREYS" placeholder="Ej. SEMIREYS, Tu Nombre, N° 10..." class="text-input-field" />
				<label class="control-label">2. Color del Texto:</label>
				<div class="text-color-presets">
					<button type="button" class="text-color-btn active" data-color="#1B2A4A" style="background-color: #1B2A4A;"></button>
					<button type="button" class="text-color-btn" data-color="#C27D38" style="background-color: #C27D38;"></button>
					<button type="button" class="text-color-btn" data-color="#FFFFFF" style="background-color: #FFFFFF; border: 1px solid #CBD5E1;"></button>
					<button type="button" class="text-color-btn" data-color="#121824" style="background-color: #121824;"></button>
					<button type="button" class="text-color-btn" data-color="#E68B75" style="background-color: #E68B75;"></button>
					<button type="button" class="text-color-btn" data-color="#4A5D4E" style="background-color: #4A5D4E;"></button>
				</div>
				<button type="button" class="btn-primary-action" id="btn-activate-text-mode">
					✍️ Fijar / Estampar Texto en Camisa
				</button>
				<div class="text-advanced-options hidden-animated" id="text-advanced-options">
					<label class="control-label">3. Espaciado de Letras:</label>
					<div class="slider-group-column">
						<div class="slider-header"><span>Espaciado:</span><span class="value-badge" id="spacing-val-badge">0px</span></div>
						<input type="range" id="text-spacing-slider" min="0" max="40" step="2" value="0" class="custom-ui-range" />
					</div>
					<label class="control-label">4. Curvatura del Texto:</label>
					<div class="slider-group-column">
						<div class="slider-header"><span>Arco:</span><span class="value-badge" id="curvature-val-badge">0° (Recto)</span></div>
						<input type="range" id="text-curvature-slider" min="-100" max="100" step="5" value="0" class="custom-ui-range" />
						<div class="curvature-labels"><span>⤺ Cóncavo</span><span>— Recto</span><span>⤻ Convexo</span></div>
					</div>
					<FontPreviewSelector />
					<div class="adjustment-header" style="margin-top: 0.5rem;">
						<span class="control-label">5. Tamaño y Rotación</span>
						<span class="decal-count-badge" id="text-count-badge">0 textos</span>
					</div>
					<div class="slider-group-column">
						<div class="slider-header"><span>Tamaño:</span><span class="value-badge" id="text-scale-val-badge">30% (~24 cm)</span></div>
						<input type="range" id="text-scale-slider" min="0.10" max="0.85" step="0.02" value="0.30" class="custom-ui-range" />
					</div>
					<div class="slider-group-column">
						<div class="slider-header"><span>Rotación:</span><span class="value-badge" id="text-rot-val-badge">0°</span></div>
						<input type="range" id="text-rotation-slider" min="-180" max="180" step="5" value="0" class="custom-ui-range" />
					</div>
					<button type="button" class="btn-secondary danger" id="btn-delete-selected-text">🗑️ Eliminar Este Texto</button>
				</div>
			</div>
		</div>

		<!-- Fixed Footer: Share CTA -->
		<div class="panel-footer">
			<button type="button" class="btn-share-footer" id="panel-share-btn">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
					<circle cx="12" cy="13" r="4" />
				</svg>
				📸 Tomar Fotos y Enviar por WhatsApp
			</button>
		</div>
	</div>

	<!-- Mobile Panel Toggle -->
	<button type="button" class="mobile-panel-toggle" id="mobile-panel-toggle" aria-expanded="false">
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
			<polyline points="18 15 12 9 6 15" />
		</svg>
		<span>Personalizar</span>
	</button>
</div>

<script src="./shirt-customizer-3d.ts"></script>
