---
interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Catálogo – Semireys", 
	description = "Colección de ropa elegante, uniformes quirúrgicos, camisas de promoción y prendas personalizadas de Semireys." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
	</head>
	<body>
		<!-- Header / Navbar -->
		<header class="navbar">
			<div class="nav-container">
				<a href="/" class="brand-logo">
					<span class="logo-accent">SEMI</span>REYS
				</a>

				<nav class="nav-links" id="nav-links">
					<a href="/" class="nav-link active">Inicio / Catálogo</a>
					
					<div class="nav-dropdown">
						<button type="button" class="nav-dropdown-btn">
							Opciones &amp; Servicios <span class="arrow-down">▾</span>
						</button>
						<div class="dropdown-menu">
							<a href="/#catalogo" class="dropdown-item">✂️ Ajustes para Vender</a>
							<a href="/#catalogo" class="dropdown-item">🌙 Pijamas Personales</a>
							<a href="/#catalogo" class="dropdown-item">👨‍👩‍👧‍👦 Pijamas Familiares</a>
							<a href="/#catalogo" class="dropdown-item">👔 Camisas Personalizadas</a>
							<a href="/#catalogo" class="dropdown-item">⚽ Uniformes Deportivos</a>
							<a href="/#catalogo" class="dropdown-item">🧵 Guayaberas</a>
							<a href="/#catalogo" class="dropdown-item">🩺 Uniformes Quirúrgicos</a>
							<a href="/#catalogo" class="dropdown-item">🎓 Camisas de Promociones</a>
						</div>
					</div>

					<a href="/#sobre-nosotros" class="nav-link">Sobre Nosotros</a>
				</nav>

				<button type="button" class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Abrir menú">
					<span class="hamburger-icon" id="hamburger-icon">☰</span>
				</button>
			</div>
		</header>

		<!-- Nav overlay for mobile -->
		<div class="nav-overlay" id="nav-overlay"></div>

		<!-- Main Content Slot -->
		<main class="main-content">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="site-footer">
			<div class="footer-container">
				<div class="footer-grid">
					<div class="footer-brand">
						<h3><span class="logo-accent">SEMI</span>REYS</h3>
						<p>Alta confección, sastrería, ropa quirúrgica y moda exclusiva a tu medida con visualización 3D.</p>
					</div>

					<div class="footer-column">
						<h4>Nuestras Opciones</h4>
						<ul>
							<li><a href="/#catalogo">✂️ Ajustes para Vender</a></li>
							<li><a href="/#catalogo">🌙 Pijamas Personales</a></li>
							<li><a href="/#catalogo">👨‍👩‍👧‍👦 Pijamas Familiares</a></li>
							<li><a href="/#catalogo">👔 Camisas Personalizadas</a></li>
							<li><a href="/#catalogo">⚽ Uniformes Deportivos</a></li>
							<li><a href="/#catalogo">🪡 Guayaberas de Lino</a></li>
							<li><a href="/#catalogo">🩺 Uniformes Quirúrgicos</a></li>
							<li><a href="/#catalogo">🎓 Camisas de Promociones</a></li>
						</ul>
					</div>

					<div class="footer-column">
						<h4>Contacto & Asistencia</h4>
						<p>💬 WhatsApp: +58 414-5321885</p>
						<p>📍 Atención personalizada para pedidos y envíos</p>
					</div>
				</div>

				<div class="footer-copy">
					&copy; {new Date().getFullYear()} SEMIREYS. Todos los derechos reservados.
				</div>
			</div>
		</footer>

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const mobileMenuBtn = document.getElementById('mobile-menu-btn');
				const navLinks = document.getElementById('nav-links');
				const hamburgerIcon = document.getElementById('hamburger-icon');
				const navDropdownBtn = document.querySelector('.nav-dropdown-btn');
				const navDropdown = document.querySelector('.nav-dropdown');
				const navOverlay = document.getElementById('nav-overlay');

				function closeMenu() {
					if (navLinks) navLinks.classList.remove('active');
					if (navOverlay) navOverlay.classList.remove('active');
					if (hamburgerIcon) hamburgerIcon.textContent = '☰';
				}

				if (mobileMenuBtn && navLinks) {
					mobileMenuBtn.addEventListener('click', () => {
						const isOpen = navLinks.classList.toggle('active');
						if (navOverlay) navOverlay.classList.toggle('active', isOpen);
						if (hamburgerIcon) hamburgerIcon.textContent = isOpen ? '✕' : '☰';
					});
				}

				// Close on overlay click
				if (navOverlay) {
					navOverlay.addEventListener('click', closeMenu);
				}

				if (navDropdownBtn && navDropdown) {
					navDropdownBtn.addEventListener('click', (e) => {
						if (window.innerWidth <= 1024) {
							e.stopPropagation();
							navDropdown.classList.toggle('active');
						}
					});
				}

				// Close menu when a link is clicked
				if (navLinks) {
					navLinks.querySelectorAll('.dropdown-item, .nav-link').forEach(link => {
						link.addEventListener('click', () => {
							if (window.innerWidth <= 1024) {
								closeMenu();
							}
						});
					});
				}
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
		--font-serif: 'Playfair Display', Georgia, serif;

		--bg-main: #FDFBF7;
		--bg-card: #FFFFFF;
		--surface-dark: #121824;
		--text-primary: #1E293B;
		--text-muted: #64748B;
		--text-light: #F8FAFC;

		--accent-primary: #C27D38;
		--accent-primary-hover: #A66627;
		--accent-secondary: #0F172A;
		--accent-soft: #FDF4EB;

		--border-color: #E2E8F0;
		--border-focus: #C27D38;

		--radius-sm: 8px;
		--radius-md: 14px;
		--radius-lg: 24px;

		--shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04);
		--shadow-md: 0 10px 30px rgba(15, 23, 42, 0.08);
		--shadow-hover: 0 20px 40px rgba(194, 125, 56, 0.12);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		font-family: var(--font-sans);
		background-color: var(--bg-main);
		color: var(--text-primary);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	.navbar {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(253, 251, 247, 0.92);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(226, 232, 240, 0.8);
		transition: all 0.3s ease;
	}

	.nav-container {
		max-width: 1240px;
		margin: 0 auto;
		padding: 1.1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.brand-logo {
		font-family: var(--font-serif);
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--accent-secondary);
		text-decoration: none;
		display: flex;
		align-items: center;
		gap: 2px;
	}

	.logo-accent {
		color: var(--accent-primary);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.75rem;
	}

	.nav-link {
		text-decoration: none;
		color: var(--text-muted);
		font-weight: 600;
		font-size: 0.95rem;
		transition: color 0.2s ease;
		position: relative;
	}

	.nav-link:hover, .nav-link.active {
		color: var(--accent-primary);
	}

	.nav-highlight {
		color: var(--accent-primary);
		background: var(--accent-soft);
		padding: 0.4rem 0.9rem;
		border-radius: var(--radius-sm);
		border: 1px solid rgba(194, 125, 56, 0.25);
	}

	.nav-highlight:hover {
		background: var(--accent-primary);
		color: #FFFFFF;
	}

	.nav-dropdown {
		position: relative;
	}

	.nav-dropdown-btn {
		background: none;
		border: none;
		font-family: inherit;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--text-muted);
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.4rem 0;
		transition: color 0.2s ease;
	}

	.nav-dropdown-btn:hover {
		color: var(--accent-primary);
	}

	.dropdown-menu {
		position: absolute;
		top: 100%;
		left: 0;
		width: 250px;
		background: #FFFFFF;
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-md);
		padding: 0.5rem 0;
		display: none;
		flex-direction: column;
		z-index: 200;
	}

	.nav-dropdown:hover .dropdown-menu {
		display: flex;
	}

	.dropdown-item {
		padding: 0.65rem 1.25rem;
		text-decoration: none;
		color: var(--text-primary);
		font-size: 0.9rem;
		font-weight: 500;
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.dropdown-item:hover {
		background-color: var(--accent-soft);
		color: var(--accent-primary);
	}

	.main-content {
		flex: 1;
		width: 100%;
	}

	.site-footer {
		background-color: var(--surface-dark);
		color: var(--text-light);
		padding: 4rem 1.5rem 2rem;
		margin-top: 4rem;
	}

	.footer-container {
		max-width: 1240px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1.5fr 1.5fr;
		gap: 3rem;
	}

	.nav-overlay {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 98;
		background: rgba(15, 23, 42, 0.35);
		backdrop-filter: blur(2px);
		pointer-events: none;
	}

	.nav-overlay.active {
		display: block;
		pointer-events: auto;
	}

	.mobile-menu-btn {
		display: none;
		background: none;
		border: 2px solid var(--accent-primary);
		border-radius: 8px;
		padding: 0.4rem 0.65rem;
		font-size: 1.25rem;
		line-height: 1;
		color: var(--accent-primary);
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.mobile-menu-btn:hover {
		background: var(--accent-soft);
	}

	@media (max-width: 1024px) {
		.mobile-menu-btn {
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.nav-container {
			flex-wrap: nowrap;
			justify-content: space-between;
		}

		.nav-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			width: 100%;
			max-height: 75vh;
			overflow-y: auto;
			flex-direction: column;
			gap: 0;
			background: rgba(253, 251, 247, 0.99);
			backdrop-filter: blur(12px);
			border-bottom: 2px solid var(--border-color);
			padding: 0.5rem 1.5rem 1rem;
			box-shadow: 0 8px 24px rgba(15, 23, 42, 0.1);
			z-index: 99;
		}

		@keyframes slideDown {
			from { opacity: 0; transform: translateY(-6px); }
			to   { opacity: 1; transform: translateY(0); }
		}

		.nav-links.active {
			display: flex;
			animation: slideDown 0.2s ease;
		}

		.nav-link {
			padding: 0.85rem 0;
			width: 100%;
			font-size: 1rem;
			border-bottom: 1px solid var(--border-color);
		}

		.nav-dropdown {
			width: 100%;
		}

		.nav-dropdown-btn {
			padding: 0.85rem 0;
			width: 100%;
			font-size: 1rem;
			justify-content: space-between;
			border-bottom: 1px solid var(--border-color);
		}

		.nav-dropdown:hover .dropdown-menu {
			display: none;
		}

		.nav-dropdown.active .dropdown-menu {
			display: flex;
			position: static;
			width: 100%;
			box-shadow: none;
			border: none;
			border-bottom: 1px solid var(--border-color);
			border-radius: 0;
			padding: 0.25rem 0 0.25rem 1rem;
			background: var(--accent-soft);
		}

		.nav-dropdown.active .dropdown-item {
			padding: 0.6rem 0.75rem;
			font-size: 0.9rem;
			color: var(--text-primary);
		}

		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}

	.footer-brand h3 {
		font-family: var(--font-serif);
		font-size: 1.75rem;
		letter-spacing: 0.1em;
		color: #FFFFFF;
		margin-bottom: 0.75rem;
	}

	.footer-brand p {
		color: #94A3B8;
		font-size: 0.92rem;
		line-height: 1.6;
		max-width: 380px;
	}

	.footer-column h4 {
		font-size: 1.05rem;
		font-weight: 700;
		color: #FFFFFF;
		margin-bottom: 1rem;
	}

	.footer-column ul {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.footer-column a {
		color: #94A3B8;
		text-decoration: none;
		font-size: 0.9rem;
		transition: color 0.2s ease;
	}

	.footer-column a:hover {
		color: var(--accent-primary);
	}

	.footer-column p {
		color: #94A3B8;
		font-size: 0.9rem;
		margin-bottom: 0.5rem;
	}

	.footer-copy {
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		padding-top: 1.75rem;
		font-size: 0.85rem;
		color: #64748B;
		text-align: center;
	}
</style>
