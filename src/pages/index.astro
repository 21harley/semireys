---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import productsData from "../data/products.json";
import tijeraImg from '../assets/tijera.jpg';
import sintaImg from '../assets/sinta.jpg';
import hiloImg from '../assets/hilo.jpg';
import agujaImg from '../assets/aguja.jpg';
import semireysLogoImg from '../assets/semireys.jpg';

// Unique values for filters
const categories = [
	{ id: "all", label: "Todas las Opciones" },
	{ id: "ajustes-vender", label: "✂️ Ajustes para Vender", icon: "✂️" },
	{ id: "pijamas-personales", label: "🌙 Pijamas Personales", icon: "🌙" },
	{ id: "pijamas-familiares", label: "👨‍👩‍👧‍👦 Pijamas Familiares", icon: "👨‍👩‍👧‍👦" },
	{
		id: "camisas-personalizadas",
		label: "👔 Camisas Personalizadas",
		icon: "👔",
	},
	{
		id: "uniformes-deportivos",
		label: "⚽ Uniformes Deportivos",
		icon: "⚽",
	},
	{ id: "guayaberas", label: "🪡 Guayaberas", icon: "🪡" },
	{ id: "quirurgicos", label: "🩺 Uniformes Quirúrgicos", icon: "🩺" },
	{
		id: "camisas-promociones",
		label: "🎓 Camisas de Promociones",
		icon: "🎓",
	},
];

const brands = Array.from(
	new Set(productsData.map((p) => p.brand).filter(Boolean)),
);
const allSizes = Array.from(
	new Set(productsData.flatMap((p) => p.sizes || [])),
);
---

<Layout
	title="Catálogo – Semireys"
	description="Explora nuestras líneas exclusivas: Ajustes para vender, pijamas personales, pijamas familiares, camisas personalizadas, uniformes deportivos, guayaberas, uniformes quirúrgicos y camisas de promociones."
>
	<!-- Hero Section -->
	<section class="hero-section">
		<div class="hero-content">
			<h1 class="hero-title">Moda, Confección & Estilo a tu Medida</h1>
			<p class="hero-description">
				Explora nuestras categorías exclusivas: guayaberas de lino,
				camisas personalizadas, pijamas familiares, uniformes
				deportivos, prendas quirúrgicas y camisas de promoción.
			</p>
		</div>
	</section>

	<!-- Catalog Section with Filters -->
	<section class="catalog-section" id="catalogo">
		<div class="container">
			<div class="section-header">
				<div>
					<h2>Catálogo General</h2>
					<p id="product-counter">
						{productsData.length} productos disponibles
					</p>
				</div>
			</div>

			<!-- Filter Bar (By Tipo de Prenda, Marca, Talla) — solo si hay más de 10 productos -->
			{
				productsData.length > 10 && (
					<div class="filter-bar">
						<div class="filter-group">
							<label for="filter-category" class="filter-label">
								Tipo de Prenda / Opción:
							</label>
							<select id="filter-category" class="filter-select">
								<option value="all">Todas las Opciones</option>
								{categories
									.filter((c) => c.id !== "all")
									.map((cat) => (
										<option value={cat.id}>
											{cat.label}
										</option>
									))}
							</select>
						</div>

						<div class="filter-group">
							<label for="filter-brand" class="filter-label">
								Marca:
							</label>
							<select id="filter-brand" class="filter-select">
								<option value="all">Todas las Marcas</option>
								{brands.map((brand) => (
									<option value={brand}>{brand}</option>
								))}
							</select>
						</div>

						<div class="filter-group">
							<label for="filter-size" class="filter-label">
								Talla:
							</label>
							<select id="filter-size" class="filter-select">
								<option value="all">Todas las Tallas</option>
								{allSizes.map((size) => (
									<option value={size}>{size}</option>
								))}
							</select>
						</div>

						<button
							type="button"
							id="reset-filters-btn"
							class="reset-filters-btn"
						>
							🔄 Limpiar Filtros
						</button>
					</div>
				)
			}

			<!-- Product Grid -->
			<div class="product-grid" id="product-grid">
				{
					productsData.map((product) => (
						<ProductCard product={product} />
					))
				}
			</div>

			<!-- Empty State -->
			<div class="empty-catalog hidden" id="empty-catalog">
				<div class="empty-icon">🔍</div>
				<h3>No se encontraron productos</h3>
				<p>
					Intenta seleccionar otra combinación de filtros de Marca,
					Talla o Tipo de prenda.
				</p>
				<button type="button" id="empty-reset-btn" class="btn-primary"
					>Ver todas las opciones</button
				>
			</div>
		</div>
	</section>

	<!-- Quick Showcase (Productos & Servicios separados) -->
	<section class="options-showcase" id="opciones">
		<div class="container">
			<!-- Servicios Section Header -->
			<div class="showcase-header services-header" id="servicios">
				<span class="showcase-badge service-badge"
					>Atención & Asesoría Directa</span
				>
				<h2>Nuestros Servicios Especializados</h2>
				<p>
					Haz clic en cualquier servicio para solicitar información
					directa vía WhatsApp
				</p>
			</div>

			<div class="options-grid services-grid">
				<div
					class="option-card service-card"
					data-service-msg="¡Hola! Quisiera solicitar información y cotización sobre el servicio de Reparación y Arreglo de Prendas."
				>
					<div class="option-icon">✂️</div>
					<h3>Reparación y Arreglo de Prendas</h3>
					<p>
						Servicio profesional de entalle, dobladillo industrial,
						ajuste y restauración de prendas a medida.
					</p>
					<span class="option-link service-link"
						>Solicitar por WhatsApp 💬</span
					>
				</div>

				<div
					class="option-card service-card"
					data-service-msg="¡Hola! Me interesa el servicio de Diseño de Logos para Bordar. ¿Podrían asesorarme con las especificaciones y presupuestos?"
				>
					<div class="option-icon">🧵</div>
					<h3>Diseño de Logos para Bordar</h3>
					<p>
						Digitalización, ponchado y adaptación de vectores e
						insignias institucionales para matriz de bordado.
					</p>
					<span class="option-link service-link"
						>Solicitar por WhatsApp 💬</span
					>
				</div>

				<div
					class="option-card service-card"
					data-service-msg="¡Hola! Deseo cotizar el servicio de Diseño de Logos para Estampar (Serigrafía / DTF / Sublimación)."
				>
					<div class="option-icon">🎨</div>
					<h3>Diseño de Logos para Estampar</h3>
					<p>
						Creación gráfica y preparación de artes finales para
						serigrafía, DTF, vinilo textil y sublimación.
					</p>
					<span class="option-link service-link"
						>Solicitar por WhatsApp 💬</span
					>
				</div>

				<div
					class="option-card service-card"
					data-service-msg="¡Hola! Quisiera obtener más información sobre la Mentoría de Aprendizaje y Pasantías en confección y sastrería en Semireys."
				>
					<div class="option-icon">🎓</div>
					<h3>Mentoría de Aprendizaje & Pasantías</h3>
					<p>
						Programas de formación práctica, tutorías técnicas de
						costura y pasantías en nuestro taller de confección.
					</p>
					<span class="option-link service-link"
						>Solicitar por WhatsApp 💬</span
					>
				</div>
			</div>
		</div>
	</section>

	<!-- Sobre Nosotros Section -->
	<section class="about-section" id="sobre-nosotros">
		<div class="container">
			<!-- Header centered -->
			<div class="about-header">
				<span class="about-eyebrow">Quiénes Somos</span>
				<h2 class="about-title">Sobre Nosotros</h2>
				<p class="about-lead">
					En <strong>Semireys</strong> nos apasiona la excelencia textil,
					combinando la tradición sartorial con innovación moderna para
					ofrecer prendas y confecciones de la más alta calidad.
				</p>
			</div>

			<!-- 3-column grid: features | logo | stats -->
			<div class="about-grid">
				<!-- Left: Features -->
				<div class="about-features">
					<div class="feature-item">
						<div class="feature-icon">✨</div>
						<div>
							<h4>Tela de Calidad</h4>
							<p>
								Seleccionamos cuidadosamente telas finas, lino,
								satén y tejidos antifluidos de máxima
								durabilidad.
							</p>
						</div>
					</div>
					<div class="feature-item">
						<div class="feature-icon">✂️</div>
						<div>
							<h4>Confección a Medida</h4>
							<p>
								Realizamos arreglos profesionales, dobladillos
								industriales y personalización exacta para cada
								cliente.
							</p>
						</div>
					</div>
					<div class="feature-item">
						<div class="feature-icon">🤝</div>
						<div>
							<h4>Atención Personalizada</h4>
							<p>
								Brindamos asesoría directa vía WhatsApp para
								pedidos corporativos, académicos y familiares.
							</p>
						</div>
					</div>
					<div class="feature-item">
						<div class="feature-icon">🎓</div>
						<div>
							<h4>Camisas de Promoción</h4>
							<p>
								Diseñamos y confeccionamos prendas únicas para
								grupos de egresados, con bordados y estampados
								personalizados.
							</p>
						</div>
					</div>
				</div>

				<!-- Center + Right: Merged logo + stats card -->
				<div class="about-combined-card">
					<!-- Logo area -->
					<div class="combined-logo-area">
						<img
							src={semireysLogoImg.src}
							alt="Logo Semireys"
							class="about-logo-img"
						/>
					</div>

					<!-- Divider -->
					<div class="combined-divider"></div>

					<!-- Stats -->
					<div class="stats-grid">
						<div class="stat-box" style={`background-image: url('${tijeraImg.src}')`}>
							<span class="stat-number">10+</span>
							<span class="stat-label">Años de Experiencia</span>
						</div>
						<div class="stat-box" style={`background-image: url('${sintaImg.src}')`}>
							<span class="stat-number">100%</span>
							<span class="stat-label">Garantía de Ajuste</span>
						</div>
						<div class="stat-box" style={`background-image: url('${hiloImg.src}')`}>
							<span class="stat-number">8</span>
							<span class="stat-label">Líneas de Confección</span>
						</div>
						<div class="stat-box" style={`background-image: url('${agujaImg.src}')`}>
							<span class="stat-number">500+</span>
							<span class="stat-label">Clientes Satisfechos</span>
						</div>
					</div>

					<!-- CTA -->
					<a
						href={`https://api.whatsapp.com/send?phone=${import.meta.env.PUBLIC_WHATSAPP_PHONE}&text=${encodeURIComponent("¡Hola! Quisiera obtener más información sobre los servicios de Semireys.")}`}
						target="_blank"
						rel="noopener noreferrer"
						class="about-cta-btn"
					>
						💬 Contáctanos por WhatsApp
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const categorySelect = document.getElementById(
			"filter-category",
		) as HTMLSelectElement | null;
		const brandSelect = document.getElementById(
			"filter-brand",
		) as HTMLSelectElement | null;
		const sizeSelect = document.getElementById(
			"filter-size",
		) as HTMLSelectElement | null;
		const resetBtn = document.getElementById("reset-filters-btn");
		const emptyResetBtn = document.getElementById("empty-reset-btn");

		const productCards =
			document.querySelectorAll<HTMLElement>(".product-card");
		const counter = document.getElementById("product-counter");
		const emptyCatalog = document.getElementById("empty-catalog");
		const optionCards =
			document.querySelectorAll<HTMLElement>(".option-card");

		function applyFilters() {
			if (!categorySelect || !brandSelect || !sizeSelect) return;

			const selectedCategory = categorySelect.value;
			const selectedBrand = brandSelect.value;
			const selectedSize = sizeSelect.value;

			let visibleCount = 0;

			productCards.forEach((card) => {
				const cardCategory = card.getAttribute("data-category") || "";
				const cardBrand = card.getAttribute("data-brand") || "";
				const rawSizes = card.getAttribute("data-sizes") || "[]";

				let cardSizes: string[] = [];
				try {
					cardSizes = JSON.parse(rawSizes);
				} catch (e) {
					cardSizes = [];
				}

				const matchCategory =
					selectedCategory === "all" ||
					cardCategory === selectedCategory;
				const matchBrand =
					selectedBrand === "all" || cardBrand === selectedBrand;
				const matchSize =
					selectedSize === "all" || cardSizes.includes(selectedSize);

				if (matchCategory && matchBrand && matchSize) {
					card.style.display = "flex";
					visibleCount++;
				} else {
					card.style.display = "none";
				}
			});

			if (counter) {
				counter.textContent = `${visibleCount} ${visibleCount === 1 ? "producto o servicio disponible" : "productos o servicios disponibles"}`;
			}

			if (emptyCatalog) {
				if (visibleCount === 0) {
					emptyCatalog.classList.remove("hidden");
				} else {
					emptyCatalog.classList.add("hidden");
				}
			}
		}

		if (categorySelect)
			categorySelect.addEventListener("change", applyFilters);
		if (brandSelect) brandSelect.addEventListener("change", applyFilters);
		if (sizeSelect) sizeSelect.addEventListener("change", applyFilters);

		function resetAll() {
			if (categorySelect) categorySelect.value = "all";
			if (brandSelect) brandSelect.value = "all";
			if (sizeSelect) sizeSelect.value = "all";
			applyFilters();
		}

		if (resetBtn) resetBtn.addEventListener("click", resetAll);
		if (emptyResetBtn) emptyResetBtn.addEventListener("click", resetAll);

		const serviceCards =
			document.querySelectorAll<HTMLElement>(".service-card");

		optionCards.forEach((card) => {
			card.addEventListener("click", () => {
				const targetCategory = card.getAttribute(
					"data-category-target",
				);
				if (targetCategory && categorySelect) {
					categorySelect.value = targetCategory;
					applyFilters();

					const catalogElem = document.getElementById("catalogo");
					if (catalogElem) {
						catalogElem.scrollIntoView({ behavior: "smooth" });
					}
				}
			});
		});

		serviceCards.forEach((card) => {
			card.addEventListener("click", () => {
				const serviceMsg = card.getAttribute("data-service-msg");
				if (serviceMsg) {
					const phone = import.meta.env.PUBLIC_WHATSAPP_PHONE;
					const encodedMsg = encodeURIComponent(serviceMsg);
					const whatsappUrl = `https://api.whatsapp.com/send?phone=${phone}&text=${encodedMsg}`;
					window.open(whatsappUrl, "_blank");
				}
			});
		});
	});
</script>

<style>
	.hero-section {
		background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
		color: #ffffff;
		padding: 4.5rem 1.5rem 4rem;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.hero-section::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: radial-gradient(
			circle at 50% 30%,
			rgba(194, 125, 56, 0.2) 0%,
			transparent 65%
		);
		pointer-events: none;
	}

	.hero-content {
		max-width: 780px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}

	.hero-subtitle {
		display: block;
		color: var(--accent-primary);
		font-size: 1.1rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	.hero-title {
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 5vw, 3.5rem);
		font-weight: 700;
		line-height: 1.15;
		margin-bottom: 1.25rem;
		background: linear-gradient(180deg, #ffffff 0%, #e2e8f0 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-description {
		font-size: 1.1rem;
		color: #94a3b8;
		line-height: 1.65;
		max-width: 660px;
		margin: 0 auto;
	}

	.container {
		max-width: 1240px;
		margin: 0 auto;
	}

	.options-showcase {
		padding: 3.5rem 1.5rem 2rem;
		background-color: var(--bg-main);
	}

	.showcase-header {
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.services-header {
		margin-top: 0;
	}

	.showcase-badge {
		display: block;
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--accent-primary);
		margin-bottom: 0.5rem;
	}

	.service-badge {
		color: #0284c7;
	}

	.showcase-header h2 {
		font-family: var(--font-serif);
		font-size: 2.2rem;
		color: var(--accent-secondary);
		margin-bottom: 0.5rem;
	}

	.showcase-header p {
		color: var(--text-muted);
		font-size: 1rem;
	}

	.options-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
	}

	.service-card {
		border-left: 4px solid #0284c7;
	}

	.service-card:hover {
		border-color: #0284c7;
	}

	.service-link {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		background: linear-gradient(135deg, #25d366 0%, #128c7e 100%);
		color: #ffffff !important;
		font-weight: 700;
		font-size: 0.88rem;
		padding: 0.65rem 1rem;
		border-radius: var(--radius-sm);
		transition: all 0.25s ease;
		box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
		margin-top: 0.25rem;
		text-align: center;
	}

	.service-card:hover .service-link {
		transform: translateY(-2px);
		box-shadow: 0 6px 18px rgba(37, 211, 102, 0.45);
	}

	.option-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md);
		padding: 1.25rem 1.25rem;
		cursor: pointer;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.5rem;
		position: relative;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
	}

	.service-card {
		padding: 1.25rem 1.15rem 1.15rem;
		gap: 0.4rem;
	}

	.option-card:hover {
		transform: translateY(-5px);
		border-color: var(--accent-primary);
		box-shadow: var(--shadow-hover);
	}

	.option-icon {
		font-size: 1.8rem;
		margin-bottom: 0.1rem;
		line-height: 1;
	}

	.option-card h3 {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--accent-secondary);
		line-height: 1.3;
	}

	.option-card p {
		font-size: 0.88rem;
		color: var(--text-muted);
		line-height: 1.45;
		flex: 1;
		margin-bottom: 0.25rem;
	}

	.option-link {
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--accent-primary);
		margin-top: 0.25rem;
		transition: transform 0.2s ease;
	}

	.service-link {
		margin-top: auto;
		padding: 0.55rem 0.85rem;
		font-size: 0.85rem;
		width: 100%;
	}

	.option-card:hover .option-link:not(.service-link) {
		transform: translateX(4px);
	}

	.catalog-section {
		padding: 3rem 1.5rem 5rem;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 1.5rem;
		padding-bottom: 0.75rem;
		border-bottom: 2px solid var(--border-color);
	}

	.section-header h2 {
		font-family: var(--font-serif);
		font-size: 2rem;
		color: var(--accent-secondary);
	}

	.section-header p {
		color: var(--text-muted);
		font-weight: 500;
	}

	.filter-bar {
		background: #ffffff;
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md);
		padding: 1.25rem 1.5rem;
		margin-bottom: 2.5rem;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 1.25rem;
		box-shadow: var(--shadow-sm);
	}

	.filter-group {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		flex: 1;
		min-width: 200px;
	}

	.filter-label {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	.filter-select {
		width: 100%;
		padding: 0.65rem 0.9rem;
		border: 1.5px solid var(--border-color);
		border-radius: var(--radius-sm);
		background-color: var(--bg-main);
		font-family: inherit;
		font-size: 0.92rem;
		color: var(--text-primary);
		outline: none;
		transition: border-color 0.2s ease;
	}

	.filter-select:focus {
		border-color: var(--accent-primary);
	}

	.reset-filters-btn {
		padding: 0.65rem 1.2rem;
		background: #f1f5f9;
		border: 1.5px solid var(--border-color);
		border-radius: var(--radius-sm);
		color: var(--text-muted);
		font-family: inherit;
		font-size: 0.9rem;
