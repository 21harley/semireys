---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import productsData from '../data/products.json';
---

<Layout title="Catálogo – Semireys" description="Explora nuestra colección exclusiva de prendas elegantes en lino y moda personalizada.">
	<!-- Hero Section -->
	<section class="hero-section">
		<div class="hero-content">
			<span class="hero-subtitle">Colección Exclusiva 2026</span>
			<h1 class="hero-title">Elegancia & Estilo a tu Medida</h1>
			<p class="hero-description">
				Descubre nuestra selección artesanal de guayaberas y camisas de lino. Elige tu prenda preferida y personalízala según tu estilo.
			</p>
		</div>
	</section>

	<!-- Catalog Grid Section -->
	<section class="catalog-section">
		<div class="container">
			<div class="section-header">
				<h2>Nuestra Colección</h2>
				<p>{productsData.length} prendas disponibles</p>
			</div>

			<div class="product-grid">
				{productsData.map((product) => (
					<ProductCard product={product} />
				))}
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero-section {
		background: linear-gradient(135deg, #121824 0%, #1E293B 100%);
		color: #FFFFFF;
		padding: 5rem 1.5rem 4rem;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.hero-section::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: radial-gradient(circle at 50% 20%, rgba(194, 125, 56, 0.15) 0%, transparent 60%);
		pointer-events: none;
	}

	.hero-content {
		max-width: 720px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}

	.hero-subtitle {
		display: inline-block;
		color: var(--accent-primary);
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		margin-bottom: 1rem;
	}

	.hero-title {
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 5vw, 3.5rem);
		font-weight: 700;
		line-height: 1.15;
		margin-bottom: 1.25rem;
		background: linear-gradient(180deg, #FFFFFF 0%, #E2E8F0 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-description {
		font-size: 1.1rem;
		color: #94A3B8;
		line-height: 1.6;
		max-width: 600px;
		margin: 0 auto;
	}

	.catalog-section {
		padding: 4rem 1.5rem;
	}

	.container {
		max-width: 1240px;
		margin: 0 auto;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 2.5rem;
		padding-bottom: 1rem;
		border-bottom: 2px solid var(--border-color);
	}

	.section-header h2 {
		font-family: var(--font-serif);
		font-size: 2rem;
		color: var(--accent-secondary);
	}

	.section-header p {
		color: var(--text-muted);
		font-weight: 500;
	}

	.product-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 2rem;
	}
</style>
