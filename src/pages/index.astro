---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import productsData from '../data/products.json';

// Unique values for filters
const categories = [
	{ id: 'all', label: 'Todas las Opciones' },
	{ id: 'ajustes-vender', label: '✂️ Ajustes para Vender', icon: '✂️' },
	{ id: 'pijamas-personales', label: '🌙 Pijamas Personales', icon: '🌙' },
	{ id: 'pijamas-familiares', label: '👨‍👩‍👧‍👦 Pijamas Familiares', icon: '👨‍👩‍👧‍👦' },
	{ id: 'camisas-personalizadas', label: '👔 Camisas Personalizadas', icon: '👔' },
	{ id: 'uniformes-deportivos', label: '⚽ Uniformes Deportivos', icon: '⚽' },
	{ id: 'guayaberas', label: '🪡 Guayaberas', icon: '🪡' },
	{ id: 'quirurgicos', label: '🩺 Uniformes Quirúrgicos', icon: '🩺' },
	{ id: 'camisas-promociones', label: '🎓 Camisas de Promociones', icon: '🎓' },
];

const brands = Array.from(new Set(productsData.map(p => p.brand).filter(Boolean)));
const allSizes = Array.from(new Set(productsData.flatMap(p => p.sizes || [])));
---

<Layout title="Catálogo – Semireys" description="Explora nuestras líneas exclusivas: Ajustes para vender, pijamas personales, pijamas familiares, camisas personalizadas, uniformes deportivos, guayaberas, uniformes quirúrgicos y camisas de promociones.">
	<!-- Hero Section -->
	<section class="hero-section">
		<div class="hero-content">
			<span class="hero-subtitle">Confección Exclusiva 2026</span>
			<h1 class="hero-title">Moda, Confección & Estilo a tu Medida</h1>
			<p class="hero-description">
				Explora nuestras categorías exclusivas: guayaberas de lino, camisas personalizadas en 3D, pijamas familiares, uniformes deportivos, prendas quirúrgicas y camisas de promoción.
			</p>
		</div>
	</section>

	<!-- Quick Showcase (Productos & Servicios separados) -->
	<section class="options-showcase" id="opciones">
		<div class="container">
			<!-- Servicios Section Header -->
			<div class="showcase-header services-header" id="servicios">
				<span class="showcase-badge service-badge">ATENCIÓN & ASESORÍA DIRECTA</span>
				<h2>Nuestros Servicios Especializados</h2>
				<p>Haz clic en cualquier servicio para solicitar información directa vía WhatsApp</p>
			</div>

			<div class="options-grid services-grid">
				<div class="option-card service-card" data-service-msg="¡Hola! Quisiera solicitar información y cotización sobre el servicio de Reparación y Arreglo de Prendas.">
					<div class="option-icon">✂️</div>
					<h3>Reparación y Arreglo de Prendas</h3>
					<p>Servicio profesional de entalle, dobladillo industrial, ajuste y restauración de prendas a medida.</p>
					<span class="option-link service-link">Solicitar por WhatsApp 💬</span>
				</div>

				<div class="option-card service-card" data-service-msg="¡Hola! Me interesa el servicio de Diseño de Logos para Bordar. ¿Podrían asesorarme con las especificaciones y presupuestos?">
					<div class="option-icon">🧵</div>
					<h3>Diseño de Logos para Bordar</h3>
					<p>Digitalización, ponchado y adaptación de vectores e insignias institucionales para matriz de bordado.</p>
					<span class="option-link service-link">Solicitar por WhatsApp 💬</span>
				</div>

				<div class="option-card service-card" data-service-msg="¡Hola! Deseo cotizar el servicio de Diseño de Logos para Estampar (Serigrafía / DTF / Sublimación).">
					<div class="option-icon">🎨</div>
					<h3>Diseño de Logos para Estampar</h3>
					<p>Creación gráfica y preparación de artes finales para serigrafía, DTF, vinilo textil y sublimación.</p>
					<span class="option-link service-link">Solicitar por WhatsApp 💬</span>
				</div>

				<div class="option-card service-card" data-service-msg="¡Hola! Quisiera obtener más información sobre la Mentoría de Aprendizaje y Pasantías en confección y sastrería en Semireys.">
					<div class="option-icon">🎓</div>
					<h3>Mentoría de Aprendizaje & Pasantías</h3>
					<p>Programas de formación práctica, tutorías técnicas de costura y pasantías en nuestro taller de confección.</p>
					<span class="option-link service-link">Solicitar por WhatsApp 💬</span>
				</div>
			</div>
		</div>
	</section>

	<!-- Catalog Section with Filters -->
	<section class="catalog-section" id="catalogo">
		<div class="container">
			<div class="section-header">
				<div>
					<h2>Catálogo General</h2>
					<p id="product-counter">{productsData.length} productos disponibles</p>
				</div>
			</div>

			<!-- Filter Bar (By Tipo de Prenda, Marca, Talla) -->
			<div class="filter-bar">
				<div class="filter-group">
					<label for="filter-category" class="filter-label">Tipo de Prenda / Opción:</label>
					<select id="filter-category" class="filter-select">
						<option value="all">Todas las Opciones</option>
						{categories.filter(c => c.id !== 'all').map(cat => (
							<option value={cat.id}>{cat.label}</option>
						))}
					</select>
				</div>

				<div class="filter-group">
					<label for="filter-brand" class="filter-label">Marca:</label>
					<select id="filter-brand" class="filter-select">
						<option value="all">Todas las Marcas</option>
						{brands.map(brand => (
							<option value={brand}>{brand}</option>
						))}
					</select>
				</div>

				<div class="filter-group">
					<label for="filter-size" class="filter-label">Talla:</label>
					<select id="filter-size" class="filter-select">
						<option value="all">Todas las Tallas</option>
						{allSizes.map(size => (
							<option value={size}>{size}</option>
						))}
					</select>
				</div>

				<button type="button" id="reset-filters-btn" class="reset-filters-btn">
					🔄 Limpiar Filtros
				</button>
			</div>

			<!-- Product Grid -->
			<div class="product-grid" id="product-grid">
				{productsData.map((product) => (
					<ProductCard product={product} />
				))}
			</div>

			<!-- Empty State -->
			<div class="empty-catalog hidden" id="empty-catalog">
				<div class="empty-icon">🔍</div>
				<h3>No se encontraron productos</h3>
				<p>Intenta seleccionar otra combinación de filtros de Marca, Talla o Tipo de prenda.</p>
				<button type="button" id="empty-reset-btn" class="btn-primary">Ver todas las opciones</button>
			</div>
		</div>
	</section>

	<!-- Sobre Nosotros Section -->
	<section class="about-section" id="sobre-nosotros">
		<div class="container">
			<div class="about-grid">
				<div class="about-text-content">
					<h2 class="about-title">Sobre Nosotros</h2>
					<p class="about-lead">
						En <strong>Semireys</strong> nos apasiona la excelencia textil, combinando la tradición sartorial con innovación moderna para ofrecer prendas y confecciones de la más alta calidad.
					</p>
					<div class="about-features">
						<div class="feature-item">
							<div class="feature-icon">✨</div>
							<div>
								<h4>Tela de Calidad</h4>
								<p>Seleccionamos cuidadosamente telas finas, lino, satén y tejidos antifluidos de máxima durabilidad.</p>
							</div>
						</div>
						<div class="feature-item">
							<div class="feature-icon">✂️</div>
							<div>
								<h4>Confección a Medida</h4>
								<p>Realizamos arreglos profesionales, dobladillos industriales y personalización exacta para cada cliente.</p>
							</div>
						</div>
						<div class="feature-item">
							<div class="feature-icon">🤝</div>
							<div>
								<h4>Atención Personalizada</h4>
								<p>Brindamos asesoría directa vía WhatsApp para pedidos corporativos, académicos y familiares.</p>
							</div>
						</div>
					</div>
				</div>

				<div class="about-stats-card">
					<div class="stats-grid">
						<div class="stat-box">
							<span class="stat-number">10+</span>
							<span class="stat-label">Años de Experiencia</span>
						</div>
						<div class="stat-box">
							<span class="stat-number">100%</span>
							<span class="stat-label">Garantía de Ajuste</span>
						</div>
						<div class="stat-box">
							<span class="stat-number">8</span>
							<span class="stat-label">Líneas de Confección</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const categorySelect = document.getElementById('filter-category') as HTMLSelectElement | null;
		const brandSelect = document.getElementById('filter-brand') as HTMLSelectElement | null;
		const sizeSelect = document.getElementById('filter-size') as HTMLSelectElement | null;
		const resetBtn = document.getElementById('reset-filters-btn');
		const emptyResetBtn = document.getElementById('empty-reset-btn');
		
		const productCards = document.querySelectorAll<HTMLElement>('.product-card');
		const counter = document.getElementById('product-counter');
		const emptyCatalog = document.getElementById('empty-catalog');
		const optionCards = document.querySelectorAll<HTMLElement>('.option-card');

		function applyFilters() {
			if (!categorySelect || !brandSelect || !sizeSelect) return;

			const selectedCategory = categorySelect.value;
			const selectedBrand = brandSelect.value;
			const selectedSize = sizeSelect.value;

			let visibleCount = 0;

			productCards.forEach((card) => {
				const cardCategory = card.getAttribute('data-category') || '';
				const cardBrand = card.getAttribute('data-brand') || '';
				const rawSizes = card.getAttribute('data-sizes') || '[]';
				
				let cardSizes: string[] = [];
				try {
					cardSizes = JSON.parse(rawSizes);
				} catch (e) {
					cardSizes = [];
				}

				const matchCategory = selectedCategory === 'all' || cardCategory === selectedCategory;
				const matchBrand = selectedBrand === 'all' || cardBrand === selectedBrand;
				const matchSize = selectedSize === 'all' || cardSizes.includes(selectedSize);

				if (matchCategory && matchBrand && matchSize) {
					card.style.display = 'flex';
					visibleCount++;
				} else {
					card.style.display = 'none';
				}
			});

			if (counter) {
				counter.textContent = `${visibleCount} ${visibleCount === 1 ? 'producto o servicio disponible' : 'productos o servicios disponibles'}`;
			}

			if (emptyCatalog) {
				if (visibleCount === 0) {
					emptyCatalog.classList.remove('hidden');
				} else {
					emptyCatalog.classList.add('hidden');
				}
			}
		}

		if (categorySelect) categorySelect.addEventListener('change', applyFilters);
		if (brandSelect) brandSelect.addEventListener('change', applyFilters);
		if (sizeSelect) sizeSelect.addEventListener('change', applyFilters);

		function resetAll() {
			if (categorySelect) categorySelect.value = 'all';
			if (brandSelect) brandSelect.value = 'all';
			if (sizeSelect) sizeSelect.value = 'all';
			applyFilters();
		}

		if (resetBtn) resetBtn.addEventListener('click', resetAll);
		if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAll);

		const serviceCards = document.querySelectorAll<HTMLElement>('.service-card');

		optionCards.forEach((card) => {
			card.addEventListener('click', () => {
				const targetCategory = card.getAttribute('data-category-target');
				if (targetCategory && categorySelect) {
					categorySelect.value = targetCategory;
					applyFilters();

					const catalogElem = document.getElementById('catalogo');
					if (catalogElem) {
						catalogElem.scrollIntoView({ behavior: 'smooth' });
					}
				}
			});
		});

		serviceCards.forEach((card) => {
			card.addEventListener('click', () => {
				const serviceMsg = card.getAttribute('data-service-msg');
				if (serviceMsg) {
					const phone = "584145321885";
					const encodedMsg = encodeURIComponent(serviceMsg);
					const whatsappUrl = `https://api.whatsapp.com/send?phone=${phone}&text=${encodedMsg}`;
					window.open(whatsappUrl, '_blank');
				}
			});
		});
	});</script>

<style>
	.hero-section {
		background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
		color: #FFFFFF;
		padding: 4.5rem 1.5rem 4rem;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.hero-section::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: radial-gradient(circle at 50% 30%, rgba(194, 125, 56, 0.2) 0%, transparent 65%);
		pointer-events: none;
	}

	.hero-content {
		max-width: 780px;
		margin: 0 auto;
		position: relative;
		z-index: 2;
	}

	.hero-subtitle {
		display: inline-block;
		color: var(--accent-primary);
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.22em;
		margin-bottom: 1rem;
		background: rgba(194, 125, 56, 0.12);
		padding: 4px 14px;
		border-radius: 20px;
		border: 1px solid rgba(194, 125, 56, 0.3);
	}

	.hero-title {
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 5vw, 3.5rem);
		font-weight: 700;
		line-height: 1.15;
		margin-bottom: 1.25rem;
		background: linear-gradient(180deg, #FFFFFF 0%, #E2E8F0 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-description {
		font-size: 1.1rem;
		color: #94A3B8;
		line-height: 1.65;
		max-width: 660px;
		margin: 0 auto;
	}

	.container {
		max-width: 1240px;
		margin: 0 auto;
	}

	.options-showcase {
		padding: 3.5rem 1.5rem 2rem;
		background-color: var(--bg-main);
	}

	.showcase-header {
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.services-header {
		margin-top: 0;
	}

	.showcase-badge {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.15em;
		color: var(--accent-primary);
		background: var(--accent-soft);
		padding: 3px 12px;
		border-radius: 12px;
		border: 1px solid rgba(194, 125, 56, 0.25);
		margin-bottom: 0.75rem;
	}

	.service-badge {
		color: #0284C7;
		background: #E0F2FE;
		border-color: #BAE6FD;
	}

	.showcase-header h2 {
		font-family: var(--font-serif);
		font-size: 2.2rem;
		color: var(--accent-secondary);
		margin-bottom: 0.5rem;
	}

	.showcase-header p {
		color: var(--text-muted);
		font-size: 1rem;
	}

	.options-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
	}

	.service-card {
		border-left: 4px solid #0284C7;
	}

	.service-card:hover {
		border-color: #0284C7;
	}

	.service-link {
		color: #0284C7;
	}

	.option-card {
		background: var(--bg-card);
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md);
		padding: 1.75rem 1.5rem;
		cursor: pointer;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		position: relative;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
	}

	.option-card:hover {
		transform: translateY(-5px);
		border-color: var(--accent-primary);
		box-shadow: var(--shadow-hover);
	}

	.option-icon {
		font-size: 2.2rem;
		margin-bottom: 0.25rem;
	}

	.option-card h3 {
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--accent-secondary);
	}

	.option-card p {
		font-size: 0.92rem;
		color: var(--text-muted);
		line-height: 1.5;
		flex: 1;
	}

	.option-link {
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--accent-primary);
		margin-top: 0.5rem;
		transition: transform 0.2s ease;
	}

	.option-card:hover .option-link {
		transform: translateX(4px);
	}

	.catalog-section {
		padding: 3rem 1.5rem 5rem;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 1.5rem;
		padding-bottom: 0.75rem;
		border-bottom: 2px solid var(--border-color);
	}

	.section-header h2 {
		font-family: var(--font-serif);
		font-size: 2rem;
		color: var(--accent-secondary);
	}

	.section-header p {
		color: var(--text-muted);
		font-weight: 500;
	}

	.filter-bar {
		background: #FFFFFF;
		border: 1px solid var(--border-color);
		border-radius: var(--radius-md);
		padding: 1.25rem 1.5rem;
		margin-bottom: 2.5rem;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 1.25rem;
		box-shadow: var(--shadow-sm);
	}

	.filter-group {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		flex: 1;
		min-width: 200px;
	}

	.filter-label {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	.filter-select {
		width: 100%;
		padding: 0.65rem 0.9rem;
		border: 1.5px solid var(--border-color);
		border-radius: var(--radius-sm);
		background-color: var(--bg-main);
		font-family: inherit;
		font-size: 0.92rem;
		color: var(--text-primary);
		outline: none;
		transition: border-color 0.2s ease;
	}

	.filter-select:focus {
		border-color: var(--accent-primary);
	}

	.reset-filters-btn {
		padding: 0.65rem 1.2rem;
		background: #F1F5F9;
		border: 1.5px solid var(--border-color);
		border-radius: var(--radius-sm);
		color: var(--text-muted);
		font-family: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	.reset-filters-btn:hover {
		background: var(--accent-soft);
		color: var(--accent-primary);
		border-color: var(--accent-primary);
	}

	.product-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 2rem;
	}

	.empty-catalog {
		text-align: center;
		padding: 4rem 2rem;
		background: #FFFFFF;
		border-radius: var(--radius-md);
		border: 1px dashed var(--border-color);
		margin-top: 1rem;
	}

	.empty-catalog.hidden {
		display: none;
	}

	.empty-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.empty-catalog h3 {
		font-size: 1.4rem;
		color: var(--accent-secondary);
		margin-bottom: 0.5rem;
	}

	.empty-catalog p {
		color: var(--text-muted);
		margin-bottom: 1.5rem;
	}

	.btn-primary {
		padding: 0.75rem 1.5rem;
		background: var(--accent-primary);
		color: #FFFFFF;
		border: none;
		border-radius: var(--radius-sm);
		font-family: inherit;
		font-size: 0.95rem;
		font-weight: 700;
		cursor: pointer;
		transition: background 0.2s ease;
	}

	.btn-primary:hover {
		background: var(--accent-primary-hover);
	}

	/* Sobre Nosotros Redesign */
	.about-section {
		background: #FFFFFF;
		padding: 5rem 1.5rem;
		border-top: 1px solid var(--border-color);
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 3.5rem;
		align-items: stretch;
	}

	@media (max-width: 900px) {
		.about-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	.about-title {
		font-family: var(--font-serif);
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--accent-secondary);
		margin-bottom: 1rem;
	}

	.about-lead {
		font-size: 1.05rem;
		color: var(--text-muted);
		line-height: 1.7;
		margin-bottom: 2rem;
	}

	.about-features {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.feature-item {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		background: var(--bg-main);
		padding: 1.1rem 1.25rem;
		border-radius: var(--radius-md);
		border: 1px solid var(--border-color);
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.feature-item:hover {
		transform: translateX(4px);
		border-color: var(--accent-primary);
	}

	.feature-icon {
		font-size: 1.5rem;
		background: var(--accent-soft);
		width: 44px;
		height: 44px;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.feature-item h4 {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--accent-secondary);
		margin-bottom: 0.2rem;
	}

	.feature-item p {
		font-size: 0.9rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.about-stats-card {
		background: linear-gradient(145deg, #0F172A 0%, #1E293B 100%);
		color: #FFFFFF;
		padding: 2.25rem 2rem;
		border-radius: var(--radius-lg);
		box-shadow: 0 20px 40px rgba(15, 23, 42, 0.15);
