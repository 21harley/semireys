---
import Layout from '../layouts/Layout.astro';
import ShirtCustomizer3D from '../components/ShirtCustomizer3D.astro';
import hiloImg from '../assets/hilo.jpg';

// Static site: product name shown in title from URL if possible
// Color/size reading is handled client-side in ShirtCustomizer3D
const productName = "Personalizador 3D";
---

<Layout title="Personalizador 3D – Semireys" description="Diseña tu prenda en 3D: elige el color, coloca logos en pecho o espalda y comparte el diseño por WhatsApp.">
	<div class="customizer-page-wrapper" style={`--bg-img: url('${hiloImg.src}')`}>
		<div class="customizer-page-container">
			<nav class="breadcrumb">
				<a href="/" class="back-link">
					<span class="arrow">←</span> Volver al Catálogo
				</a>
			</nav>

			<ShirtCustomizer3D productName={productName} />
		</div>
	</div>
</Layout>

<style>
	.customizer-page-wrapper {
		width: 100%;
		position: relative;
		overflow: hidden;
	}

	.customizer-page-wrapper::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image: var(--bg-img);
		background-size: 300px;
		background-repeat: repeat;
		opacity: 0.05;
		pointer-events: none;
		z-index: 0;
	}

	[data-theme="dark"] .customizer-page-wrapper::before {
		filter: invert(1);
		opacity: 0.03;
	}

	.customizer-page-container {
		max-width: 1400px;
		margin: 0 auto;
		padding: 1.5rem 1.5rem 3rem;
		position: relative;
		z-index: 1;
	}

	.breadcrumb {
		margin-bottom: 1.25rem;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--text-muted);
		font-weight: 600;
		font-size: 0.95rem;
		transition: color 0.2s ease;
	}

	.back-link:hover {
		color: var(--accent-primary);
	}
</style>
